# Contoh konfigurasi backend – JANGAN isi kredensial asli di file ini.
# Salin ke server/.env untuk penggunaan lokal dan jangan commit .env.

# --- Google API (Service Account) ---
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY_ID=
# Path ke file service account (relatif terhadap server/ atau absolut lokal).
# File asli: server/credentials/*.json – jangan pernah commit.
GOOGLE_APPLICATION_CREDENTIALS=./credentials/aksara-2026-514022-584b4a49f95d.json

# --- Google Drive / Sheets ---
# ID folder induk logbook (dari README.md – URL folder induk).
GOOGLE_DRIVE_LOG_BOOK_PARENT_FOLDER_ID=1KPltSlYvp8gboHi69aC7FzyDW98mjJPm
# ID folder induk dokumentasi – dikonfirmasi pengguna 2026-11-08.
GOOGLE_DRIVE_DOC_PARENT_FOLDER_ID=1T3Ll14UO5ux7fsG9XmHnMimPMb9qW0Ce
# ID spreadsheet template utama (dari README.md).
GOOGLE_SHEETS_TEMPLATE_ID=1wqk5PhRfPVcFQdV8p5AIs0S_BSKLywHfEsMq6zYFSV8

# --- OAuth user untuk upload Drive (kuota user, lihat docs/OAUTH-SETUP.md) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# --- Backend ---
PORT=3000
NODE_ENV=development
